{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RustShark",
  "version": "0.1.0",
  "identifier": "io.github.jeanjacquesserpoul.rustshark",
  "build": {
    "beforeDevCommand": "trunk serve",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "trunk build --release",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "RustShark",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "license": "MIT",
    "shortDescription": "Analyseur réseau pour tous, assisté par IA",
    "longDescription": "RustShark capture et explique le trafic réseau en langage simple, avec une analyse assistée par IA (DeepSeek, OpenRouter).",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
